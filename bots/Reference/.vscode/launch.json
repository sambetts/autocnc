{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch AutoC&C",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/../../engine/bin/OpenRA.dll",
            "args": [
                "Engine.EngineDir=${workspaceFolder}/../../engine",
                "Engine.ModSearchPaths=${workspaceFolder}/../../mods,${workspaceFolder}/../../engine/mods",
                "Game.Mod=autocnc",
                "Launch.BattleBotPath=${workspaceFolder}/../../engine/bin/bots/AutoCnC.Reference.dll"
            ],
            "cwd": "${workspaceFolder}/../../engine/bin",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Attach to AutoC&C",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
