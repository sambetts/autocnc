<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Doctrines consume AutoC&C from a LOCAL package feed, not nuget.org. Point <add value=...>
    at the packages/ folder of any AutoC&C checkout, or at a folder you copied the .nupkg files
    into, and the doctrine builds anywhere.
  -->
  <packageSources>
    <add key="autocnc-local" value="..\..\packages" />
  </packageSources>
</configuration>