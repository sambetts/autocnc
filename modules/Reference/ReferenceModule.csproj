<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoCnC.Reference</RootNamespace>
    <AssemblyName>AutoCnC.Reference</AssemblyName>
    <Description>The reference AutoC&amp;C battle module. Copy this to start your own.</Description>

    <!-- Modules are discovered by scanning this folder; they are NOT listed in mod.yaml. -->
    <OutputPath>$(AutoCnCBinDirectory)\modules\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Modes\*.cs" />
    <Compile Include="Logic\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AutoCnC.Core">
      <HintPath>$(AutoCnCBinDirectory)\AutoCnC.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AutoCnC.Sdk">
      <HintPath>$(AutoCnCBinDirectory)\AutoCnC.Sdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenRA.Game">
      <HintPath>$(AutoCnCBinDirectory)\OpenRA.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenRA.Mods.Common">
      <HintPath>$(AutoCnCBinDirectory)\OpenRA.Mods.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyPlatformIsBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AutoCnCBinDirectory)\AutoCnC.Sdk.dll')"
           Text="AutoC&amp;C SDK not found. Build the platform first (./scripts/build.ps1), or set AutoCnCPath to an AutoC&amp;C checkout. Looked in: $(AutoCnCBinDirectory)" />
  </Target>

</Project>