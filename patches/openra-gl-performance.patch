+++ b/OpenRA.Test/OpenRA.Platforms.Default/OpenGLTest.cs
@@ -0,0 +1,26 @@
+using System;
+using System.Reflection;
+using System.Text;
+using NUnit.Framework;
+
+namespace OpenRA.Test
+{
+	[TestFixture]
+	sealed class OpenGLTest
+	{
+		[TestCase(0x9146)]
+		[TestCase(0x9147)]
+		public void PerformanceWarningsAreNonfatal(int severity)
+		{
+			var gl = Assembly.Load("OpenRA.Platforms.Default").GetType("OpenRA.Platforms.Default.OpenGL", true);
+			var handler = gl.GetMethod("DebugMessageHandler", BindingFlags.Static | BindingFlags.NonPublic);
+			var message = new StringBuilder(
+				"API_ID_RECOMPILE_FRAGMENT_SHADER performance warning has been generated. Fragment shader recompiled due to state change.");
+
+			Assert.DoesNotThrow(() => handler.Invoke(null, new object[]
+			{
+				0x8246, 0x8250, 0u, severity, message.Length, message, IntPtr.Zero
+			}));
+		}
+	}
+}
