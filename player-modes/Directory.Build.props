<Project>

  <!-- Mirrors src/Directory.Build.props so player modes build the same way as shipped code. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <EngineDirectory Condition="'$(EngineDirectory)' == ''">$(MSBuildThisFileDirectory)..\engine</EngineDirectory>
    <EngineBinDirectory>$(EngineDirectory)\bin</EngineBinDirectory>
  </PropertyGroup>

</Project>
