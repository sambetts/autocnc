<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlayerModes</RootNamespace>
    <AssemblyName>PlayerModes</AssemblyName>
    <Description>Your own AutoC&amp;C unit modes. Every .cs file in this folder is compiled automatically.</Description>

    <!--
      Output into the engine's bin directory alongside AutoCnC.Mod.dll. mod.yaml lists
      PlayerModes.dll in its Assemblies section, so OpenRA's ObjectCreator finds your modes
      by reflection. There is no separate loader and no registration step: add a class,
      rebuild, restart the game.
    -->
    <OutputPath>$(EngineBinDirectory)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Your modes are your business; don't fail your build on style warnings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\AutoCnC.Modes.Core\AutoCnC.Modes.Core.csproj" />
    <ProjectReference Include="..\src\AutoCnC.Mod\AutoCnC.Mod.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenRA.Game">
      <HintPath>$(EngineBinDirectory)\OpenRA.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenRA.Mods.Common">
      <HintPath>$(EngineBinDirectory)\OpenRA.Mods.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
