<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoCnC.Sdk</RootNamespace>
    <AssemblyName>AutoCnC.Sdk</AssemblyName>
    <Description>The AutoC&amp;C doctrine SDK: IDoctrine, IUnitMode and ModeContext.</Description>
    <OutputPath>$(EngineBinDirectory)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <PackageId>AutoCnC.Sdk</PackageId>
    <PackageDescription>Write AutoC&amp;C doctrines: IDoctrine, IUnitMode and ModeContext.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCnC.Core\AutoCnC.Core.csproj" />
  </ItemGroup>

  <!-- The SDK deliberately does not reference the platform: modules depend on this, not the host. -->
  <ItemGroup>
    <Reference Include="OpenRA.Game">
      <HintPath>$(EngineBinDirectory)\OpenRA.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenRA.Mods.Common">
      <HintPath>$(EngineBinDirectory)\OpenRA.Mods.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The package carries the OpenRA reference assemblies it was built against, because a doctrine
    cannot compile without Actor/CPos/WDist and OpenRA is not published to NuGet. They are GPL,
    which is why this package is GPL-3.0-or-later and links to the source repository.

    Consumers set CopyLocalLockFileAssemblies=false (or ExcludeAssets=runtime) so these are used
    for compilation only and never copied beside a built doctrine — the game already has them.
  -->
  <ItemGroup>
    <None Include="$(EngineBinDirectory)\OpenRA.Game.dll" Pack="true" PackagePath="lib\net8.0\" Visible="false" />
    <None Include="$(EngineBinDirectory)\OpenRA.Mods.Common.dll" Pack="true" PackagePath="lib\net8.0\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Target Name="VerifyEngineIsBuilt" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(EngineBinDirectory)\OpenRA.Game.dll')"
           Text="OpenRA engine not built. Run ./scripts/build.ps1 first. Looked in: $(EngineBinDirectory)" />
  </Target>

</Project>